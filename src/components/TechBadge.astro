// TechBadge.astro — Tech badge with proper brand SVG icons.
// Icons: 36 from Simple Icons (CC0), 15 custom for techs not in the catalog.
// All tech names are normalized to lowercase alphanum to match ICONS keys.
type IconName =
  | 'magento' | 'wordpress' | 'php' | 'java' | 'react' | 'angular' | 'nextjs'
  | 'laravel' | 'javascript' | 'typescript' | 'html5' | 'css3' | 'less'
  | 'knockoutjs' | 'requirejs' | 'jquery' | 'mysql' | 'git' | 'docker'
  | 'elasticsearch' | 'redis' | 'varnish' | 'gtm' | 'ga' | 'litespeed'
