// Lookup: try the original key first, then the normalized form
const entry = ICONS[name] ?? ICONS[normalize(name)];
const color = entry?.color ?? '#6b7280';
const path = entry?.path;
const fontSize = size === 'sm' ? 11 : 13;
const iconSize = size === 'sm' ? 14 : 18;
---
<span class="tech-badge" data-known={String(!!path)} style={`--tech-color: ${color};`}>
  {path && (
    <svg class="tech-badge__icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true">
      <path d={path} fill="currentColor" />
    </svg>
  )}
  <span class="tech-badge__label" style={`font-size:${fontSize}px;`}>{name}</span>
</span>
<style>
  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tech-color) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--tech-color) 32%, transparent);
    color: var(--color-fg);
    line-height: 1;
    white-space: nowrap;
  }
  .tech-badge[data-known="false"] {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .tech-badge__icon {
    color: var(--tech-color);
    flex: 0 0 auto;
  }
  .tech-badge__label {
    color: var(--color-fg);
    font-weight: 500;
  }
</style>
