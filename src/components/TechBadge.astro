  | 'Google Tag Manager' | 'Google Analytics' | 'HTML semántico'
  | 'Laravel' | 'Next.js' | 'PHP' | 'Angular' | 'JavaScript' | 'TypeScript'
  | 'Python' | 'CSS' | 'HTML' | 'LESS' | 'JS' | 'TS'
  | 'jQuery' | 'Knockout' | 'jQuery';

interface Props {
  name: string;
  size?: 'sm' | 'md';
}

const { name, size = 'md' } = Astro.props as Props;

// Normalize: strip accents, lowercase, alphanum only
function normalize(n: string): string {
  return n
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');
}

