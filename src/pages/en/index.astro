---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Contact from '../../components/Contact.astro';
import PendingAsset from '../../components/PendingAsset.astro';
import { getProfile, getCaseStudies } from '../../lib/content';
import { pending } from '../../lib/assets';
import { canonical } from '../../lib/seo';
const profile = await getProfile('en');
const labels = { email: profile.email, phone: profile.phone, linkedin: 'LinkedIn', heading: 'Contact' };
const commerceStudies = await getCaseStudies('en', { audience: 'commerce' });
---
<BaseLayout locale="en" title="José Luis Pintado Vásquez — Portfolio" description="Bilingual portfolio" path="/">
  <Hero locale="en" headline={profile.headline} summary={profile.summary} />
  {profile.cvPdf ? (
    <a class="cv-download" href={profile.cvPdf} download type="application/pdf" rel="noopener">
      <span class="cv-download__label">{profile.cvLabel ?? 'Download résumé'}</span>
      <span class="cv-download__detail">{profile.cvDetail ?? ''}</span>
    </a>
  ) : (
    <PendingAsset asset={pending('CV / Résumé', 'Pending: /cv.pdf has not been published yet.')} />
  )}

  <section class="case-studies" aria-labelledby="case-studies-heading-en">
    <h2 id="case-studies-heading-en">E-commerce case studies</h2>
    <p class="case-studies__intro">Selected Magento 2 and multistore projects in production.</p>
    <ul class="case-studies__list">
      {commerceStudies.map((study) => (
        <li>
          <a class="case-card" href={canonical(`/case-studies/${study.slug}/`, 'en')} hreflang="en">
            <p class="case-card__client">{study.client}</p>
            <h3 class="case-card__title">{study.title}</h3>
            <p class="case-card__summary">{study.summary}</p>
            <p class="case-card__meta">
              <span>{study.role}</span>
              <span aria-hidden="true">·</span>
              <span>{study.period}</span>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Contact email={profile.email} phone={profile.phone} linkedin={profile.linkedin} labels={labels} />
</BaseLayout>
