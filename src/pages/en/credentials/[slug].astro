---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PendingAsset from '../../../components/PendingAsset.astro';
import PdfPreview from '../../../components/PdfPreview.astro';
import { getCredentialDetail } from '../../../lib/content';
import { locales, type Locale } from '../../../lib/i18n';
import { canonical } from '../../../lib/seo';

export async function getStaticPaths() {
  const { getCredentials } = await import('../../../lib/content');
  const items = await getCredentials('en');
  return items.map((c) => ({ params: { slug: c.slug } }));
}

const locale: Locale = 'en';
const { slug } = Astro.params;
if (!slug || typeof slug !== 'string') return Astro.redirect('/en/');

const detail = await getCredentialDetail(locale, slug);
if (!detail) return new Response('Not found', { status: 404 });

const pageTitle = `${detail.title} — ${detail.issuer}`;
---
<BaseLayout locale={locale} title={pageTitle} description={detail.summary ?? detail.title} path={`/credentials/${slug}/`}>
  <article class="credential-detail">
    <p class="credential-detail__meta">
      <span>{detail.issuer}</span>
      <span aria-hidden="true">·</span>
      <span>{detail.year}</span>
      {detail.hours && (
        <>
          <span aria-hidden="true">·</span>
          <span>{detail.hours} h</span>
        </>
      )}
    </p>
    <h1 class="gradient-text">{detail.title}</h1>
    {detail.summary && <p>{detail.summary}</p>}

    <nav aria-label="Switch language">
      <ul class="lang-switch lang-switch--inline">
        {locales.map((alt) => (
          <li>
            <a href={canonical(`/credentials/${slug}/`, alt)} hreflang={alt} lang={alt} aria-current={alt === locale ? 'page' : undefined}>{alt.toUpperCase()}</a>
          </li>
        ))}
      </ul>
    </nav>

    {(detail.pdf || detail.pdfs.length > 0) ? (
      <section class="credential-detail__downloads" aria-labelledby="cred-downloads-heading">
        <h2 id="cred-downloads-heading">Document</h2>
        <ul class="credential-detail__download-list">
          {(detail.pdf ? [detail.pdf] : detail.pdfs).filter((p, i, arr) => arr.indexOf(p) === i).map((url) => {
            const filename = url.split('/').pop() ?? 'document.pdf';
            const label = detail.pdfs.length > 1 ? filename.replace('.pdf', '').replace(/-/g, ' ') : 'Credential';
            return (
              <li>
                <PdfPreview src={url} label={label} downloadName={filename} downloadLabel="Download" previewLabel="Preview" closeLabel="Close preview" />
              </li>
            );
          })}
        </ul>
      </section>
    ) : (
      <aside class="pending-asset" role="note">
        <p><strong>Credential pending publication</strong> · <span>{detail.pendingAssets.length > 0 ? detail.pendingAssets.join(' · ') : 'Document not publicly available yet'}</span></p>
      </aside>
    )}

    <p><a href={canonical('/', locale)}>← Back to home</a></p>
  </article>
</BaseLayout>
