---
import { getSite, getProfile } from '../lib/content';
import { canonical, personJsonLd, websiteJsonLd, profilePageJsonLd, breadcrumbJsonLd, OG_IMAGE } from '../lib/seo';
import { locales, type Locale } from '../lib/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionGuard from '../components/MotionGuard.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props { locale: Locale; title: string; description: string; path?: string }
const { locale, title, description, path = '/' } = Astro.props;
const SITE_ORIGIN = 'https://josepintado24.github.io';
const site = await getSite(locale);
const profile = await getProfile(locale);
const url = canonical(path, locale);
const personLd = JSON.stringify(personJsonLd({ author: profile.name ?? site.author, linkedin: profile.linkedin, github: profile.github }));
const websiteLd = JSON.stringify(websiteJsonLd());
const profilePageLd = JSON.stringify(profilePageJsonLd(locale, { author: profile.name ?? site.author, linkedin: profile.linkedin, github: profile.github }));
const breadcrumbLd = JSON.stringify(breadcrumbJsonLd(locale, [
  { name: site.title, url: SITE_ORIGIN },
  { name: locale.toUpperCase(), url: url },
]));
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {locales.map((alt) => <link rel="alternate" hreflang={alt} href={canonical(path, alt)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <link rel="image_src" href={OG_IMAGE} />
    <script type="application/ld+json" set:html={personLd} />
    <script type="application/ld+json" set:html={websiteLd} />
    <script type="application/ld+json" set:html={profilePageLd} />
    <script type="application/ld+json" set:html={breadcrumbLd} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <Header locale={locale} site={site} profile={profile} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer locale={locale} site={site} />
    <MotionGuard />
    <WhatsAppFab locale={locale} phone={profile.phone} />
  </body>
</html>